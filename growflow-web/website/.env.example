# GrowFlow website environment variables.
#
# Copy this file to `.env.local` and fill in real values once the Supabase backend exists.
# Only PUBLIC values belong here — everything prefixed NEXT_PUBLIC_ is shipped to the
# browser, so it must never contain secret keys.
#
# Secret keys (SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, DEEPGRAM_API_KEY) live ONLY
# inside Supabase Edge Functions, never in this web app.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe for the browser, RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------------------
# SERVER-ONLY secrets. These are read only inside the API routes (app/api/*), which run on
# the server (Vercel). They are NEVER prefixed NEXT_PUBLIC and never reach the browser.
# ---------------------------------------------------------------------------------------

# Anthropic API key — used by app/api/analyze to score activity with Claude. If unset, the
# route falls back to the local mock heuristic so the demo still works.
ANTHROPIC_API_KEY=

# Optional: override the Claude model id (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=

# Supabase service-role key — lets the API route write the new plant growth to the shared
# `plants` table so the Flutter app updates. Server-only; if unset, the write is skipped.
SUPABASE_SERVICE_ROLE_KEY=
