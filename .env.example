# GrowFlow environment variables — TEMPLATE.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored; this
# template is committed, so it must contain only placeholders, never secrets.
#
# Three groups below, by where the value is allowed to live:
#   1. CLIENT   — safe to compile into the Flutter app (public).
#   2. SERVER   — Edge Function secrets; MUST stay server-side, never shipped.
#   3. AUTH     — Google OAuth credentials read by supabase/config.toml locally.

# -----------------------------------------------------------------------------
# 1. CLIENT (Flutter Web/Desktop)
# Passed at build/run time via --dart-define (see "How to run" below). Protected
# by Row Level Security, so these are safe in the client bundle.
# -----------------------------------------------------------------------------

# Base project URL: https://<project-ref>.supabase.co
# Use the base origin only — do NOT append /rest/v1/ (supabase_flutter adds it).
SUPABASE_URL=https://your-project-ref.supabase.co

# Public/anon client key. With the new key format this is the `sb_publishable_...`
# key (Settings -> API). It is consumed as `publishableKey` in supabase_flutter.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 2. SERVER — Edge Function secrets (NEVER ship to the client)
# Set with: supabase secrets set KEY=value   (or in the dashboard).
# -----------------------------------------------------------------------------

# Service role key — bypasses RLS. Used by ingest-activity to resolve pairing
# tokens. Legacy format is a JWT (role=service_role); new format is `sb_secret_...`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for analyze-productivity (Claude tool-use scoring).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Claude model id (config-driven). Default opus; sonnet is the cheaper scoring loop.
ANTHROPIC_MODEL=claude-opus-4-8

# DeepGram API key for the tts Edge Function (aura voice model).
DEEPGRAM_API_KEY=your-deepgram-key

# -----------------------------------------------------------------------------
# 3. AUTH — Google OAuth (read by supabase/config.toml for local supabase start)
# Create credentials in Google Cloud Console; for hosted projects set these in
# the Supabase dashboard (Authentication -> Providers -> Google) instead.
# -----------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# How to run the Flutter app with the client values above:
#
#   flutter run -d chrome \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# (On Windows PowerShell, substitute the values inline or use $env: variables.)
# -----------------------------------------------------------------------------
